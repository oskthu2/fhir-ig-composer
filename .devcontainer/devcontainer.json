{
  "name": "fhir-ig-composer",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "studio",
  "runServices": [
    "studio",
    "register"
  ],
  "workspaceFolder": "/arbetsyta",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/devcontainers/features/ruby:1": {}
  },
  "postCreateCommand": "npm ci --prefix verktyg && touch /tmp/studio-klar && gem install jekyll --no-document && (node verktyg/ig-composer.mjs bygg || true)",
  "postStartCommand": "touch /tmp/studio-klar",
  "forwardPorts": [
    4900,
    4901,
    4800,
    8080
  ],
  "portsAttributes": {
    "4900": {
      "label": "Studio",
      "onAutoForward": "openBrowser"
    },
    "4901": {
      "label": "Studio, testmiljö"
    },
    "4800": {
      "label": "Mockad federation"
    },
    "8080": {
      "label": "Definitionsregister (HAPI R5)"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "MITRE-Health.vscode-language-fsh",
        "redhat.vscode-yaml"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "overrideCommand": false
}
